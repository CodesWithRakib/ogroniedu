# ==============================================================================
# OgroniEdu — Vercel Production Environment Variables (Web Frontend)
# ==============================================================================
# Instructions:
# In Vercel: Dashboard -> Your Project -> Settings -> Environment Variables.
# You can copy and paste the values below directly or upload this file.
# Select Environment: Check "Production" (and "Preview" if desired).
# ==============================================================================

NODE_ENV=production

# The public URL where the frontend is hosted on Vercel
# Update with your actual deployed Vercel domain (e.g. https://ogroniedu-web.vercel.app)
NEXT_PUBLIC_APP_URL=https://ogroniedu-web.vercel.app

# The backend API URL hosted on Render (matches render.yaml service name 'ogroniedu-api')
NEXT_PUBLIC_API_URL=https://ogroniedu-api.onrender.com

# ------------------------------------------------------------------------------
# Supabase Storage & Client Auth (Public)
# ------------------------------------------------------------------------------
# Retrieve from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key

# ------------------------------------------------------------------------------
# Live Video Classroom (Option 6 - Jitsi Meet)
# ------------------------------------------------------------------------------
# Default free public domain (works instantly with 0 setup): meet.jit.si
# Or set your custom Jitsi instance domain / 8x8 JaaS domain
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
NEXT_PUBLIC_JITSI_APP_ID=
NEXT_PUBLIC_JITSI_JWT=
