# ==============================================================================
# OgroniEdu — Render Production Environment Variables (NestJS Backend API)
# ==============================================================================
# Instructions:
# In Render: Dashboard -> Web Service (ogroniedu-api) -> Environment -> "Add from .env"
# Paste or upload these key-value pairs directly.
# ==============================================================================

NODE_ENV=production
PORT=10000

# ------------------------------------------------------------------------------
# Frontend URL & CORS Configuration
# ------------------------------------------------------------------------------
# Update with your Vercel deployment URL and/or custom domain
FRONTEND_URL=https://ogroniedu-web.vercel.app
CORS_ORIGINS=https://ogroniedu-web.vercel.app,https://ogroniedu.com

# ------------------------------------------------------------------------------
# Authentication Security (CRITICAL)
# ------------------------------------------------------------------------------
# MUST be a secure 64+ character random string in production (not default)
# You can generate a new one via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ogroniedu_prod_jwt_secret_9c7f21a48b03e6d15f8a2c7e4b901d3a5e8f2c1b7a0d9e4f6a8b2c1d3e5f7a9b

# ------------------------------------------------------------------------------
# Managed PostgreSQL Database (Supabase / Neon / Render Postgres / AWS RDS)
# ------------------------------------------------------------------------------
# Full Connection String (sslmode=require is mandatory for production):
DATABASE_URL=postgresql://postgres.your-project-id:your-secure-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Individual Connection Parameters (used by TypeORM pool fallback):
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.your-project-id
DB_PASSWORD=your-secure-db-password
DB_NAME=postgres
DB_SSL=true
DB_POOL_MAX=20

# ------------------------------------------------------------------------------
# Supabase Storage Configuration (Private & Server-Side Credentials)
# ------------------------------------------------------------------------------
# Retrieve from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# Redis Cache (Optional for single instance, recommended for multi-instance)
# ------------------------------------------------------------------------------
# If you created a Redis instance on Render, fill in the connection details:
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# OTP & Notification Delivery Provider
# ------------------------------------------------------------------------------
# In production, http_gateway is required (dev mock adapter is rejected by safety guards)
OTP_SMS_PRIMARY_PROVIDER=http_gateway
OTP_SMS_FALLBACK_PROVIDER=http_gateway
OTP_EMAIL_PRIMARY_PROVIDER=http_gateway
OTP_EMAIL_FALLBACK_PROVIDER=http_gateway
OTP_HTTP_GATEWAY_NAME=http_gateway
OTP_HTTP_GATEWAY_SMS_URL=https://api.sms-provider.com/v1/send
OTP_HTTP_GATEWAY_EMAIL_URL=https://api.email-provider.com/v1/send
OTP_HTTP_GATEWAY_API_KEY=your_sms_gateway_api_key
OTP_HTTP_GATEWAY_SENDER_ID=OGRONI
OTP_DELIVERY_TIMEOUT_MS=5000
OTP_DELIVERY_MAX_ATTEMPTS=2
