{
  "name": "@ogroniedu/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); if(fs.existsSync('src/migrations')) fs.cpSync('src/migrations', 'dist/migrations', { recursive: true });\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/run-migrations.mjs",
    "db:seed": "node scripts/run-seeds.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@ogroniedu/tsconfig": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
