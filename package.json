{
  "name": "ogroniedu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @ogroniedu/database db:migrate",
    "db:seed": "pnpm --filter @ogroniedu/database db:seed",
    "docs:validate": "node scripts/validate-documentation.js",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\""
  },
  "type": "module",
  "devDependencies": {
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.10.1"
}
