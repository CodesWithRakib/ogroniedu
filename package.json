{
  "name": "ogroniedu",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@ogroniedu/web...",
    "build:api": "turbo run build --filter=@ogroniedu/api...",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @ogroniedu/database db:migrate",
    "db:seed": "pnpm --filter @ogroniedu/database db:seed",
    "docs:validate": "node scripts/validate-documentation.js",
    "tunnel": "node scripts/tunnel.js",
    "ui:add": "pnpm dlx shadcn@latest add -c apps/web",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "lint": "turbo run lint",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:redis": "docker start ogroni_redis || docker run -d --name ogroni_redis --restart unless-stopped -p 6379:6379 redis:7-alpine",
    "docker:ps": "docker ps"
  },
  "type": "module",
  "devDependencies": {
    "oxlint": "^1.88.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.10.1"
}
