# ==============================================================================
# OgroniEdu — Vercel Production Environment Variables (Web Frontend)
# ==============================================================================
NODE_ENV=production

# Public URLs
NEXT_PUBLIC_APP_URL=https://ogroniedu-web.vercel.app
NEXT_PUBLIC_API_URL=https://ogroniedu-api.onrender.com

# Supabase Storage & Client Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-publishable-key

# Live Video Classroom (Option 6 - Jitsi Meet)
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si
NEXT_PUBLIC_JITSI_APP_ID=
NEXT_PUBLIC_JITSI_JWT=
