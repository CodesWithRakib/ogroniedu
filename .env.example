# Root Environment Template
NODE_ENV=development

# Database Configuration (PostgreSQL 18)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ogroniedu_dev

# Backend API & WebSocket
PORT=4000
API_BASE_URL=http://localhost:4000
JWT_SECRET=super-secret-ogroniedu-development-key-256-bit-long-string-sample

# Frontend URL
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Gateway Sandbox Config (SSLCOMMERZ / bKash)
SSLCOMMERZ_STORE_ID=sandbox_ogroni_edu
SSLCOMMERZ_STORE_PASSWD=sandbox_secret
SSLCOMMERZ_IS_LIVE=false
