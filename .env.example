# Root Environment Template
NODE_ENV=development

# Database Configuration (PostgreSQL 18 / Cloud Neon / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ogroniedu_dev
DB_SSL=false

# Storage Configuration (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Backend API & WebSocket
PORT=4000
API_BASE_URL=http://localhost:4000
JWT_SECRET=super-secret-ogroniedu-development-key-256-bit-long-string-sample

# Frontend URL
FRONTEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379

# Gateway Sandbox Config (SSLCOMMERZ / bKash)
SSLCOMMERZ_STORE_ID=sandbox_ogroni_edu
SSLCOMMERZ_STORE_PASSWD=sandbox_secret
SSLCOMMERZ_IS_LIVE=false

# ---------------------------------------------------------------------------
# OTP delivery provider chain (Phase 01)
# Primary provider delivers live; the configured fallback is used only for
# eligible (retryable) delivery failures. The `dev` adapter cannot be selected
# in production. Set the gateway URL/API key for the contracted SMS aggregator
# or email API — no vendor endpoint is hardcoded.
# ---------------------------------------------------------------------------
OTP_SMS_PRIMARY_PROVIDER=http_gateway
OTP_SMS_FALLBACK_PROVIDER=dev
OTP_EMAIL_PRIMARY_PROVIDER=http_gateway
OTP_EMAIL_FALLBACK_PROVIDER=dev
OTP_HTTP_GATEWAY_NAME=http_gateway
OTP_HTTP_GATEWAY_SMS_URL=
OTP_HTTP_GATEWAY_EMAIL_URL=
OTP_HTTP_GATEWAY_API_KEY=
OTP_HTTP_GATEWAY_SENDER_ID=
OTP_HTTP_GATEWAY_FALLBACK_NAME=http_gateway_fallback
OTP_HTTP_GATEWAY_FALLBACK_SMS_URL=
OTP_HTTP_GATEWAY_FALLBACK_EMAIL_URL=
OTP_HTTP_GATEWAY_FALLBACK_API_KEY=
OTP_HTTP_GATEWAY_FALLBACK_SENDER_ID=
OTP_DELIVERY_TIMEOUT_MS=5000
OTP_DELIVERY_MAX_ATTEMPTS=2
